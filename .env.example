# Proofsheet environment. Copy to .env and fill the key. Never commit .env.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

PROOFSHEET_BIND=0.0.0.0:8080
PROOFSHEET_DATA_DIR=data
PROOFSHEET_DATABASE_URL=sqlite://data/proofsheet.db
PROOFSHEET_SANDBOX=auto
PROOFSHEET_SANDBOX_IMAGE=proofsheet-sandbox:latest
PROOFSHEET_SANDBOX_TIMEOUT=90
PROOFSHEET_MODEL_PLAN=deepseek-v4.1-flash-1017
PROOFSHEET_MODEL_CODE=qwen3.8-27b
PROOFSHEET_MODEL_REPAIR=deepseek-v4.1-flash-1017
PROOFSHEET_CANARY_PATH=data/canary.txt
PROOFSHEET_REGION=local
RUST_LOG=info
