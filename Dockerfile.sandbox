# Proofsheet execution image.
# Deliberately boring: Python, pandas, matplotlib. No network tools, no secrets,
# no package manager use at runtime. The orchestrator mounts a per-run workdir.
FROM python:3.12-slim

RUN pip install --no-cache-dir \
    pandas==2.2.3 \
    numpy==2.1.3 \
    matplotlib==3.9.2

WORKDIR /work
ENV HOME=/tmp \
    MPLCONFIGDIR=/tmp/mpl \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

CMD ["python3", "-c", "print('proofsheet-sandbox-ok')"]
